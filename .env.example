# Infrastructure only. Trading settings live in SQLite, never here.
# Copy to .env locally. Do not put Hyperliquid keys in git.

LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/newhbot.db
EXECUTION_WORKER_URL=http://127.0.0.1:8001
EXECUTION_WORKER_WRITE_TIMEOUT_SECONDS=60
EXECUTION_WORKER_READ_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EXECUTION_MODE=mock
EXECUTION_ENABLED=false
HUMMINGBOT_VERSION=v2.16.0
# Worker rejects new opens after this many seconds without a Backend heartbeat.
BACKEND_HEARTBEAT_TIMEOUT_SECONDS=30
# Optional SQLite backup settings (defaults: ./data/backups/newhbot.db and 300 seconds).
# DATABASE_BACKUP_PATH=./data/backups/newhbot.db
# DATABASE_BACKUP_INTERVAL_SECONDS=300
# Never set HUMMINGBOT_LIVE_CONNECTOR or real keys in this file.
# Copy to untracked .env for STEP 4 authenticated read (EXECUTION_ENABLED stays false):
# HYPERLIQUID_PERPETUAL_ADDRESS=
# HYPERLIQUID_PERPETUAL_SECRET_KEY=
# CONTROL_API_TOKEN=placeholder-for-non-mock-control-plane (injected by frontend Nginx at runtime)
# Hyperliquid domain is testnet by default; never put real credentials here.
HYPERLIQUID_DOMAIN=hyperliquid_perpetual_testnet
